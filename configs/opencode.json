{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "hostlinku": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hostlinku",
      "options": {
        "baseURL": "https://api.hostlinku.com/v1",
        "apiKey": "{file:~/.config/opencode/hostlinku-api-key.txt}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "gpt-5-5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        }
      }
    }
  },
  "model": "hostlinku/claude-sonnet-4-6"
}
